# Copy this file to .env and fill it in. NEVER commit .env to Git.
#
# Generate random secrets with:
#   python -c "import secrets; print('sk-' + secrets.token_hex(24))"

# The real OpenAI key from your instructor. Only the proxy server ever sees it.
OPENAI_API_KEY=sk-proj-...

# Admin key for the proxy. Used to create member keys and view spend.
# Give it to the one or two people who administer the proxy, nobody else.
LITELLM_MASTER_KEY=sk-change-me

# Used to encrypt secrets in the database. Set once and never change it.
LITELLM_SALT_KEY=sk-change-me-too

# Password for the Postgres container.
POSTGRES_PASSWORD=change-me

# Login for the web dashboard at http://<host>:4000/ui (username: admin)
UI_PASSWORD=change-me

# Used by the helper scripts (setup_keys.py, spend_report.py).
PROXY_URL=http://localhost:4000
